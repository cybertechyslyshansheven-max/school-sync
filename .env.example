SUPABASE_SERVICE_ROLE_KEY=            # server only! Never put in js/config.js
RESEND_API_KEY=                       # from resend.com
EMAIL_FROM=SchoolSync <notifications@your-verified-domain.com>
SITE_URL=https://your-site.netlify.app
SCHOOL_TIMEZONE=Asia/Manila
REMIND_HOURS_BEFORE=24
